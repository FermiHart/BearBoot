{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bearboot.dev/schemas/bbp-execution-evidence-v1.schema.json",
  "title": "BearBoot execution evidence bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "provenance",
    "scope",
    "identity",
    "execution",
    "artifacts"
  ],
  "properties": {
    "schema": {
      "const": "bbp-execution-evidence-v1"
    },
    "provenance": {
      "enum": ["execution", "fixture"]
    },
    "scope": {
      "enum": ["hosted", "emulator", "physical"]
    },
    "identity": {
      "type": "object"
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "exit_code",
        "timed_out",
        "pass_marker",
        "verdict"
      ],
      "properties": {
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "exit_code": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 255
        },
        "timed_out": {
          "type": "boolean"
        },
        "pass_marker": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\r\\n]+$"
        },
        "verdict": {
          "const": "PASS"
        }
      },
      "oneOf": [
        {
          "properties": {
            "timed_out": {"const": false},
            "exit_code": {"type": "integer"}
          }
        },
        {
          "properties": {
            "timed_out": {"const": true},
            "exit_code": {"const": null}
          }
        }
      ]
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "role", "media_type", "size", "sha256"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^artifacts/[A-Za-z0-9][A-Za-z0-9._+-]*$"
          },
          "role": {
            "enum": ["raw-serial", "runner-log", "artifact"]
          },
          "media_type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9.+-]*/[A-Za-z0-9][A-Za-z0-9.+-]*$"
          },
          "size": {
            "type": "integer",
            "minimum": 0,
            "maximum": 67108864
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      },
      "contains": {
        "properties": {
          "role": {"const": "raw-serial"}
        },
        "required": ["role"]
      },
      "minContains": 1,
      "maxContains": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "scope": {"const": "hosted"}
        }
      },
      "then": {
        "properties": {
          "identity": {
            "type": "object",
            "additionalProperties": false,
            "required": ["host"],
            "properties": {
              "host": {
                "type": "object",
                "additionalProperties": false,
                "required": ["architecture", "operating_system"],
                "properties": {
                  "architecture": {"type": "string", "minLength": 1},
                  "operating_system": {"type": "string", "minLength": 1}
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "scope": {"const": "emulator"}
        }
      },
      "then": {
        "properties": {
          "identity": {
            "type": "object",
            "additionalProperties": false,
            "required": ["emulator"],
            "properties": {
              "emulator": {
                "type": "object",
                "additionalProperties": false,
                "required": ["architecture", "name", "version", "machine"],
                "properties": {
                  "architecture": {"type": "string", "minLength": 1},
                  "name": {"type": "string", "minLength": 1},
                  "version": {"type": "string", "minLength": 1},
                  "machine": {"type": "string", "minLength": 1}
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "scope": {"const": "physical"}
        }
      },
      "then": {
        "properties": {
          "identity": {
            "type": "object",
            "additionalProperties": false,
            "required": ["board"],
            "properties": {
              "board": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "architecture",
                  "manufacturer",
                  "model",
                  "revision",
                  "serial_number"
                ],
                "properties": {
                  "architecture": {"type": "string", "minLength": 1},
                  "manufacturer": {"type": "string", "minLength": 1},
                  "model": {"type": "string", "minLength": 1},
                  "revision": {"type": "string", "minLength": 1},
                  "serial_number": {"type": "string", "minLength": 1}
                }
              }
            }
          }
        }
      }
    }
  ]
}
